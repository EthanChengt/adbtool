plugins {
    id 'com.android.application'
}

android {
	namespace "com.didjdk.adbhelper"
    compileSdkVersion 28

    defaultConfig {
        applicationId 'com.didjdk.adbhelper'
        minSdkVersion 19
        //noinspection ExpiringTargetSdkVersion,ExpiredTargetSdkVersion
        targetSdkVersion 28
        versionCode 17
        versionName "1.3.1"
        vectorDrawables.useSupportLibrary = true

        testInstrumentationRunner "androidx.test.runner.AndroidJUnitRunner"
    }

    buildTypes {
        release {
            minifyEnabled false
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
        }
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_1_8
        targetCompatibility JavaVersion.VERSION_1_8
    }

    lintOptions {
        abortOnError false
    }

    buildFeatures {
        buildConfig = false
    }
}

sourceSets {
    main {
        // 原工程把 JNI .so 放在 src/main/lib，而不是 AGP 默认 src/main/jniLibs。
        jniLibs.srcDirs = ['src/main/lib']
        // JADX 生成的 R.java 应由 Android Gradle Plugin 根据 res/ 重新生成，避免重复定义。
        java {
            exclude 'com/didjdk/adbhelper/R.java'
        }
    }
}

dependencies {
    // 当前反编译工程已将大部分保留的 AndroidX / Material / Glide 实现放入 src/main/java。
    // 先不要猜测 Maven 版本；后续以编译错误和资源引用校验再决定是否添加依赖。
}
