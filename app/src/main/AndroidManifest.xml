        <activity
            android:theme="@style/j"
            android:name="com.didjdk.adbhelper.RemoteActivity"/>
        <activity
            android:theme="@style/k"
            android:name="com.didjdk.adbhelper.FilePickerActivity"/>
        <activity
            android:theme="@style/k"
            android:name="com.didjdk.adbhelper.ConnectActivity"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/k"
            android:name="com.didjdk.adbhelper.MainActivity"
