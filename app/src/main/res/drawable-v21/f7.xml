<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ej">
    <item android:id="@android:id/mask">
        <inset
            android:insetLeft="@dimen/bl"
            android:insetRight="@dimen/bl"
            android:insetTop="@dimen/bm"
            android:insetBottom="@dimen/bm">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/bp"/>
                <solid android:color="@android:color/white"/>
