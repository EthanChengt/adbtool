<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:id="@+id/rc"
        android:drawable="@drawable/gi"/>
    <item
        android:id="@+id/ii"
        android:drawable="@drawable/gj"/>
    <transition
        android:drawable="@drawable/f6"
        android:toId="@+id/rc"
        android:fromId="@+id/ii"/>
    <transition
        android:drawable="@drawable/f5"
        android:toId="@+id/ii"
        android:fromId="@+id/rc"/>
</animated-selector>
