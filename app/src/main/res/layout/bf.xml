<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="@style/lz"
        android:id="@+id/pb"
        android:background="@color/a5"
        android:layout_width="match_parent"
        android:layout_height="?attr/d"
        app:navigationIcon="@drawable/e5"
        app:popupTheme="@style/m3"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.google.android.material.appbar.AppBarLayout
            android:theme="@style/m7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="8dp">
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/ns"
                android:background="@color/a5"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                app:layout_scrollFlags="0x15"
                app:tabMode="0"
                app:tabPadding="0dp"
                app:tabTextAppearance="@style/l"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.core.widget.NestedScrollView
            android:background="@color/a5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_behavior="@string/ad">
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/rb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_behavior="@string/ad"/>
        </androidx.core.widget.NestedScrollView>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_gravity="end|bottom"
            android:id="@+id/ek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="32dp"
            android:contentDescription="TODO"
            app:srcCompat="@drawable/de"/>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_gravity="end|bottom"
            android:id="@+id/el"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="32dp"
            android:contentDescription="TODO"
            app:srcCompat="@drawable/de"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:id="@+id/f6"
        android:background="@color/a5"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/br"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/gb"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:srcCompat="@drawable/cx"/>
            <TextView
                android:gravity="center"
                android:id="@+id/qk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下载"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/bp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/ga"
                android:padding="2dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:srcCompat="@drawable/cy"/>
            <TextView
                android:gravity="center"
                android:id="@+id/qd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="复制"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/bq"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/gc"
                android:padding="2dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:srcCompat="@drawable/ct"/>
            <TextView
                android:gravity="center"
                android:id="@+id/qe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="剪切"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/bs"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/gd"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:srcCompat="@drawable/d5"/>
            <TextView
                android:gravity="center"
                android:id="@+id/qo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更多"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
