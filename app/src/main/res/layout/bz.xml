<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.AlertDialogLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start|top"
    android:orientation="vertical"
    android:id="@+id/l1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/c1"/>
    <FrameLayout
        android:id="@+id/d8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <View
            android:layout_gravity="top"
            android:id="@+id/ma"
            android:background="?attr/dt"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/mb"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <android.widget.Space
                    android:id="@+id/ob"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aa"/>
                <TextView
                    android:id="@android:id/message"
                    android:paddingLeft="?attr/fl"
                    android:paddingRight="?attr/fl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="?attr/lx"/>
                <android.widget.Space
                    android:id="@+id/oa"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/aa"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/m_"
            android:background="?attr/dt"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/db"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <FrameLayout
            android:id="@+id/da"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/c0"/>
</androidx.appcompat.widget.AlertDialogLayout>
