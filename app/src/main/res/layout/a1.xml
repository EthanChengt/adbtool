<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/ie"
        android:textColor="?attr/s9"
        android:ellipsize="end"
        android:id="@+id/ja"
        android:background="?attr/s_"
        android:paddingLeft="@dimen/ia"
        android:paddingTop="@dimen/ie"
        android:paddingRight="@dimen/ia"
        android:paddingBottom="@dimen/ie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ib"
        android:maxWidth="256dp"
        android:maxLines="3"
        android:paddingStart="@dimen/ia"
        android:paddingEnd="@dimen/ia"/>
</LinearLayout>
