<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ig"
        android:background="@color/a1"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:k6="l0"
        app:ko="l0"
        app:kr="l0">
        <TextView
            android:textColor="@color/e2"
            android:ellipsize="start"
            android:id="@+id/qr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TextView"
            android:singleLine="true"
            android:layout_weight="1"/>
        <com.google.android.material.chip.Chip
            android:textSize="12sp"
            android:textColor="@color/f4"
            android:id="@+id/c2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:text="@string/g4"
            app:chipSurfaceColor="@color/e8"/>
        <com.google.android.material.chip.Chip
            android:textSize="12sp"
            android:textColor="@color/f4"
            android:id="@+id/bx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:text="@string/g3"
            android:textAllCaps="false"
            app:chipSurfaceColor="@color/e8"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ih"
        android:background="@color/a1"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:k6="l0"
        app:ko="l0"
        app:kr="l0">
        <TextView
            android:textColor="@color/e2"
            android:id="@+id/qu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Textview"
            android:layout_weight="1"/>
        <com.google.android.material.chip.Chip
            android:textColor="@color/f4"
            android:id="@+id/f7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aq"
            app:chipEndPadding="12dp"
            app:chipStartPadding="12dp"
            app:chipSurfaceColor="@color/e8"/>
        <Button
            android:textSize="12sp"
            android:id="@+id/c1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:minWidth="48dp"
            android:minHeight="42dp"
            android:text="反选"/>
        <Button
            android:textSize="12sp"
            android:id="@+id/c0"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:minWidth="48dp"
            android:minHeight="42dp"
            android:text="全选"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/lt"
        android:background="@color/a4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="48dp"
        app:k0="l0"
        app:k6="l0"
        app:ko="l0"
        app:kr="l0">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lr"
            android:scrollbars="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
