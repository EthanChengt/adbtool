<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/a5"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="640dp">
        <androidx.appcompat.widget.Toolbar
            android:theme="@style/lz"
            android:id="@+id/pc"
            android:layout_width="match_parent"
            android:layout_height="?attr/d"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:k6="0"
            app:ko="0"
            app:kr="0"
            app:navigationIcon="@drawable/dz"
            app:popupTheme="@style/m3"/>
        <ImageView
            android:id="@+id/gi"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="96dp"
            app:k6="0"
            app:ko="0"
            app:kr="0"
            app:srcCompat="@drawable/bv"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/h3"
            android:background="@drawable/ac"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            app:k6="0"
            app:ko="0"
            app:kq="@+id/gi">
            <ImageView
                android:id="@+id/fz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="#ffffc107"
                android:layout_marginStart="8dp"
                app:srcCompat="@drawable/e0"/>
            <AutoCompleteTextView
                android:id="@+id/eg"
                android:background="@null"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/cs"
                android:cursorVisible="true"
                android:ems="10"
                android:singleLine="false"
                android:popupBackground="@drawable/ac"
                android:layout_weight="1"
                android:paddingStart="4dp"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:id="@+id/gy"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:tint="#ff03a9f4"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                app:srcCompat="@drawable/e_"/>
        </LinearLayout>
        <com.google.android.material.chip.Chip
            android:textColor="@color/f4"
            android:id="@+id/bw"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginTop="23dp"
            android:text="@string/b5"
            android:textAlignment="center"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            app:chipSurfaceColor="@color/e8"
            app:k6="0"
            app:ke="1"
            app:ko="0"
            app:kq="@+id/h3"/>
        <TextView
            android:textColor="@color/e8"
            android:gravity="center"
            android:id="@+id/qv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/gz"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:k6="0"
            app:ko="0"
            app:kq="@+id/bw"/>
        <ListView
            android:id="@+id/id"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:listSelector="@android:color/transparent"
            android:divider="@null"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:k0="0"
            app:k6="0"
            app:ko="0"
            app:kq="@+id/qv"
            app:ks="0"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
