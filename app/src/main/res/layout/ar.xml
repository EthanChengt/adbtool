<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/f3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:k6="0"
        app:ko="0"
        app:kr="0">
        <TextView
            android:textSize="18sp"
            android:textColor="?attr/e0"
            android:id="@+id/jo"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="动画缩放调整"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:k6="0"
            app:ko="0"
            app:kr="0"/>
        <TextView
            android:textSize="14sp"
            android:id="@+id/re"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="窗口动画缩放倍数"
            android:layout_marginStart="32dp"
            app:ko="0"
            app:kq="@+id/jo"/>
        <EditText
            android:id="@+id/rf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0"
            android:inputType="numberDecimal"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="32dp"
            app:k0="@+id/re"
            app:k6="0"
            app:ke="1"
            app:kn="@+id/re"
            app:kr="@+id/re"/>
        <SeekBar
            android:id="@+id/mr"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:max="80"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="16dp"
            app:k1="@+id/pi"
            app:k6="0"
            app:ko="0"
            app:kq="@+id/re"/>
        <TextView
            android:textSize="14sp"
            android:id="@+id/pi"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="过渡动画缩放倍数"
            android:layout_marginStart="32dp"
            app:ko="0"
            app:kq="@+id/mr"/>
        <EditText
            android:id="@+id/pj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0"
            android:inputType="numberDecimal"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="32dp"
            app:k0="@+id/pi"
            app:k6="0"
            app:ke="1"
            app:kn="@+id/pi"
            app:kr="@+id/pi"/>
        <SeekBar
            android:id="@+id/mq"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:max="80"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="16dp"
            app:k1="@+id/bh"
            app:k6="0"
            app:ko="0"
            app:kq="@+id/pi"/>
        <TextView
            android:textSize="14sp"
            android:id="@+id/bh"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="动画时长缩放倍数"
            android:layout_marginStart="32dp"
            app:ko="0"
            app:kq="@+id/mq"/>
        <EditText
            android:id="@+id/bi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0"
            android:inputType="numberDecimal"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="32dp"
            app:k0="@+id/bh"
            app:k6="0"
            app:ke="1"
            app:kn="@+id/bh"
            app:kr="@+id/bh"/>
        <SeekBar
            android:id="@+id/mp"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:max="80"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="16dp"
            app:k1="@+id/jn"
            app:k6="0"
            app:ko="0"
            app:kq="@+id/bh"/>
        <Button
            android:id="@+id/jn"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/eg"
            android:layout_marginEnd="16dp"
            app:k0="0"
            app:k6="0"
            style="@style/q4"/>
        <Button
            android:id="@+id/jk"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aq"
            android:layout_marginStart="16dp"
            app:k0="@+id/jn"
            app:ko="0"
            app:kr="@+id/jn"
            style="@style/q4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
