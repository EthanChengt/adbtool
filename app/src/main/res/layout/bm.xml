<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/e2"
        android:id="@+id/ox"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="概览"
        android:layout_marginStart="10dp"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="6dp"
        app:cardElevation="5dp"
        app:cardUseCompatPadding="true">
        <LinearLayout
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/gp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:tint="#ff1e88e5"
                    android:layout_marginStart="8dp"
                    app:k0="0"
                    app:ko="0"
                    app:kr="0"
                    app:srcCompat="@drawable/e8"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="?attr/e0"
                    android:id="@+id/qh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Xiaomi Redmi Note 5"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:k0="0"
                    app:kn="@+id/gp"
                    app:kr="0"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/gh"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:tint="#ff009688"
                    android:layout_marginStart="8dp"
                    app:k0="0"
                    app:ko="0"
                    app:kr="0"
                    app:srcCompat="@drawable/df"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/pv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="版本"
                    android:layout_marginEnd="8dp"
                    app:k0="0"
                    app:k6="0"
                    app:kr="0"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="?attr/e0"
                    android:id="@+id/qj"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Android 11"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:k0="0"
                    app:k7="@+id/pv"
                    app:kn="@+id/gh"
                    app:kr="0"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/gz"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:tint="#ff26c6da"
                    android:layout_marginStart="8dp"
                    app:k0="0"
                    app:ko="0"
                    app:kr="0"
                    app:srcCompat="@drawable/dv"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/q8"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="分辨率"
                    android:layout_marginEnd="8dp"
                    app:k0="0"
                    app:k6="0"
                    app:kr="0"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="?attr/e0"
                    android:id="@+id/q7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="1080 x 1920"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:k0="0"
                    app:k7="@+id/q8"
                    app:kn="@+id/gz"
                    app:kr="0"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/gj"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:tint="#ff827717"
                    android:layout_marginStart="8dp"
                    app:k0="0"
                    app:ko="0"
                    app:kr="0"
                    app:srcCompat="@drawable/e4"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/pr"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="CPU"
                    android:layout_marginEnd="8dp"
                    app:k0="0"
                    app:k6="0"
                    app:kr="0"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="?attr/e0"
                    android:id="@+id/pq"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="SDM636"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:k0="0"
                    app:k7="@+id/pr"
                    app:kn="@+id/gj"
                    app:kr="0"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/gs"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:tint="#ff0277bd"
                    android:layout_marginStart="8dp"
                    app:k0="0"
                    app:ko="0"
                    app:kr="0"
                    app:srcCompat="@drawable/dl"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/ok"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="运行内存"
                    android:layout_marginEnd="8dp"
                    app:k0="0"
                    app:k6="0"
                    app:kr="0"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="?attr/e0"
                    android:id="@+id/q0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="4.0 GB"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:k0="0"
                    app:k7="@+id/ok"
                    app:kn="@+id/gs"
                    app:kr="0"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/gt"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:tint="#ff8e24aa"
                    android:layout_marginStart="8dp"
                    app:k0="0"
                    app:ko="0"
                    app:kr="0"
                    app:srcCompat="@drawable/ee"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/q2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:text="存储空间"
                    android:layout_marginEnd="8dp"
                    app:k0="0"
                    app:k6="0"
                    app:kr="0"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?attr/e0"
                    android:id="@+id/q1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="总计64 GB / 可用 10 GB"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:k7="@+id/q2"
                    app:kn="@+id/gt"
                    app:kr="0"/>
                <ProgressBar
                    android:id="@+id/lf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:k0="0"
                    app:k7="@+id/q2"
                    app:kn="@+id/gt"
                    app:kq="@+id/q1"
                    style="?android:attr/progressBarStyleHorizontal"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
