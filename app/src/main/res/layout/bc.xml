<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/i7"
            android:padding="1dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:k6="l0"
            app:ko="l0"
            app:kr="l0">
            <ImageView
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="@color/e8"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:srcCompat="@drawable/ap"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/e8"
                android:id="@+id/lv"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前设备系统版本过低，使用兼容模式"
                android:paddingEnd="24dp"/>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/ly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/hy"
                        android:background="?android:attr/selectableItemBackground"
                        android:visibility="visible"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="?attr/e0"
                            android:gravity="right"
                            android:id="@+id/ql"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="24dp"
                            android:text="@string/fz"
                            android:layout_marginStart="16dp"
                            app:k0="l0"
                            app:ko="l0"
                            app:kr="l0"/>
                        <TextView
                            android:gravity="right"
                            android:id="@+id/q5"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:text="@string/er"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="24dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:kn="@+id/ql"
                            app:kr="l0"/>
                        <View
                            android:id="@+id/dv"
                            android:background="?android:attr/listDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:ko="l0"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/hu"
                        android:background="?android:attr/selectableItemBackground"
                        android:visibility="visible"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="?attr/e0"
                            android:gravity="right"
                            android:id="@+id/qn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="24dp"
                            android:text="@string/am"
                            android:layout_marginStart="16dp"
                            app:k0="l0"
                            app:ko="l0"
                            app:kr="l0"/>
                        <TextView
                            android:gravity="right"
                            android:id="@+id/q3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:text="@string/bi"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="24dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:kn="@+id/qn"
                            app:kr="l0"/>
                        <View
                            android:id="@+id/du"
                            android:background="?android:attr/listDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:ko="l0"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/i0"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="?attr/e0"
                            android:id="@+id/of"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="24dp"
                            android:text="@string/ai"
                            android:layout_marginStart="16dp"
                            app:k0="l0"
                            app:ko="l0"
                            app:kr="l0"/>
                        <TextView
                            android:gravity="right"
                            android:id="@+id/q6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:text="@string/bi"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="24dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:kn="@+id/of"
                            app:kr="l0"/>
                        <View
                            android:id="@+id/dw"
                            android:background="?android:attr/listDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:ko="l0"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/hx"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="?attr/e0"
                            android:id="@+id/op"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="24dp"
                            android:text="导航栏位置"
                            android:layout_marginStart="16dp"
                            app:k0="l0"
                            app:ko="l0"
                            app:kr="l0"/>
                        <TextView
                            android:gravity="right"
                            android:id="@+id/q4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:text="不显示"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="24dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:kn="@+id/op"
                            app:kr="l0"/>
                        <View
                            android:id="@+id/dy"
                            android:background="?android:attr/listDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:ko="l0"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/hv"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="?attr/e0"
                            android:id="@+id/ol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="24dp"
                            android:text="@string/ch"
                            android:layout_marginStart="16dp"
                            app:k0="l0"
                            app:ko="l0"
                            app:kr="l0"/>
                        <CheckBox
                            android:id="@+id/cm"
                            android:clickable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:kr="l0"/>
                        <View
                            android:id="@+id/dx"
                            android:background="?android:attr/listDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:ko="l0"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/hz"
                        android:background="?android:attr/selectableItemBackground"
                        android:visibility="visible"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="?attr/e0"
                            android:id="@+id/om"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="24dp"
                            android:text="@string/b_"
                            android:layout_marginStart="16dp"
                            app:k0="l0"
                            app:ko="l0"
                            app:kr="l0"/>
                        <CheckBox
                            android:id="@+id/co"
                            android:clickable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:kr="l0"/>
                        <View
                            android:id="@+id/dt"
                            android:background="?android:attr/listDivider"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:ko="l0"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/hw"
                        android:background="?android:attr/selectableItemBackground"
                        android:visibility="visible"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="?attr/e0"
                            android:id="@+id/p1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:layout_marginBottom="24dp"
                            android:text="兼容模式"
                            android:layout_marginStart="16dp"
                            app:k0="l0"
                            app:ko="l0"
                            app:kr="l0"/>
                        <CheckBox
                            android:id="@+id/cn"
                            android:clickable="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            app:k0="l0"
                            app:k6="l0"
                            app:kr="l0"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.cardview.widget.CardView>
        <Button
            android:id="@+id/bz"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="12dp"
            android:text="@string/b5"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
