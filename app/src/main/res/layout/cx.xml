<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nj"
    android:layout_width="match_parent"
    android:layout_height="128dp">
    <ImageView
        android:id="@+id/fu"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:scaleType="centerCrop"/>
    <include
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        layout="@layout/ct"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ku"
        android:paddingTop="@dimen/hr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="128dp"
        android:minHeight="@dimen/hp"
        android:layout_toLeftOf="@+id/c9"
        android:layout_marginStart="128dp"
        android:layout_toStartOf="@+id/c9">
        <FrameLayout
            android:id="@+id/kt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/hs"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/hs"
            android:layout_marginEnd="8dp"/>
        <FrameLayout
            android:id="@+id/m2"
            android:paddingTop="@dimen/hu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp">
            <DateTimeView
                android:textAppearance="@style/j5"
                android:layout_gravity="end|top"
                android:id="@+id/p8"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <Chronometer
                android:textAppearance="@style/j5"
                android:layout_gravity="end|top"
                android:id="@+id/cz"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textAppearance="@style/j0"
                android:layout_gravity="end|bottom"
                android:id="@+id/h0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:singleLine="true"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ij"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_toRightOf="@+id/fu"
        android:layout_alignParentBottom="true"
        android:layoutDirection="ltr"
        android:layout_toEndOf="@+id/fu"/>
    <ImageView
        android:id="@+id/ay"
        android:background="?android:attr/dividerHorizontal"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_toRightOf="@+id/fu"
        android:layout_above="@+id/ij"
        android:layout_toEndOf="@+id/fu"/>
</RelativeLayout>
