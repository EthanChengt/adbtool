<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/m1"
    android:gravity="bottom"
    android:orientation="vertical"
    android:background="@color/a5"
    android:paddingLeft="@dimen/bf"
    android:paddingTop="@dimen/bg"
    android:paddingRight="@dimen/bf"
    android:paddingBottom="@dimen/bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/g0"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/e5"
        app:srcCompat="@drawable/bv"/>
    <TextView
        android:textColor="@color/bw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/be"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/e2"
                android:id="@+id/qq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/d1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/bw"
                android:id="@+id/qp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/d1"/>
        </LinearLayout>
        <com.google.android.material.chip.Chip
            android:textColor="@color/f4"
            android:id="@+id/by"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fn"
            app:chipEndPadding="8dp"
            app:chipStartPadding="8dp"
            app:chipSurfaceColor="@color/e8"/>
    </LinearLayout>
</LinearLayout>
