<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/f0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="所在路径"/>
    <TextView
        android:id="@+id/f3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="类型"/>
    <TextView
        android:id="@+id/f1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="权限"/>
    <TextView
        android:id="@+id/f4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="拥有者"/>
    <TextView
        android:id="@+id/ez"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="用户组"/>
    <TextView
        android:id="@+id/f2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="文件大小"/>
    <TextView
        android:id="@+id/ey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="最后修改时间"/>
</LinearLayout>
