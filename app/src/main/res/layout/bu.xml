<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/g_"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:tint="#ffff9800"
                android:layout_marginStart="16dp"
                app:k0="@+id/oz"
                app:ko="l0"
                app:kr="@+id/oz"
                app:srcCompat="@drawable/di"/>
            <TextView
                android:textSize="18sp"
                android:id="@+id/oz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ca"
                android:layout_marginStart="16dp"
                app:k1="@+id/oy"
                app:kn="@+id/g_"
                app:kr="l0"/>
            <TextView
                android:id="@+id/oy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cm"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:k1="@+id/od"
                app:k6="l0"
                app:ko="l0"
                app:kq="@+id/oz"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/e2"
                android:id="@+id/od"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="@string/b9"
                android:lineSpacingExtra="8sp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:k0="l0"
                app:k6="l0"
                app:ko="l0"
                app:kq="@+id/oy"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="4dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/gf"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:tint="#ffe91e63"
                android:layout_marginStart="16dp"
                app:k0="@+id/ow"
                app:ko="l0"
                app:kr="@+id/ow"
                app:srcCompat="@drawable/ds"/>
            <TextView
                android:textSize="18sp"
                android:id="@+id/ow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/h3"
                android:layout_marginStart="16dp"
                app:k1="@+id/og"
                app:kn="@+id/gf"
                app:kr="l0"/>
            <TextView
                android:id="@+id/og"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fa"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:k1="@+id/c3"
                app:k6="l0"
                app:ko="l0"
                app:kq="@+id/ow"/>
            <Button
                android:id="@+id/c3"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/i6"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:k7="@+id/ex"
                app:kg="1"
                app:ko="l0"
                app:kq="@+id/og"
                app:ky="50"/>
            <Button
                android:id="@+id/ex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="@string/ao"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:k1="@+id/oi"
                app:k6="l0"
                app:kg="1"
                app:kn="@+id/c3"
                app:kr="@+id/c3"/>
            <TextView
                android:id="@+id/oi"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:k1="@+id/c4"
                app:k6="l0"
                app:ko="l0"
                app:kq="@+id/ex"/>
            <Button
                android:id="@+id/c4"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:k0="l0"
                app:k6="l0"
                app:ke="0.6"
                app:ko="l0"
                app:kq="@+id/oi"
                style="@style/q3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</merge>
