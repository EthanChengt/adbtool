<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/i6"
    android:background="#ff000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/m8"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <SurfaceView
            android:layout_gravity="center"
            android:id="@+id/nn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/lk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/on"/>
        <com.didjdk.adbhelper.view.ControlView
            android:id="@+id/d9"
            android:background="#00ffffff"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textColor="@color/f4"
                android:id="@+id/lz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""/>
            <com.didjdk.adbhelper.view.DragView
                android:layout_gravity="right"
                android:orientation="vertical"
                android:id="@+id/e0"
                android:layout_width="48dp"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/gm"
                    android:padding="4dp"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:alpha="0.8"
                    app:srcCompat="@drawable/bv"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/lw"
                    android:background="@drawable/af"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/gx"
                        android:padding="8dp"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:tint="#ffffffff"
                        android:alpha="0.8"
                        app:k6="0"
                        app:ko="0"
                        app:kr="0"
                        app:srcCompat="@drawable/dp"/>
                    <ImageView
                        android:id="@+id/gw"
                        android:padding="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:tint="#ffffffff"
                        android:alpha="0.8"
                        app:k6="0"
                        app:ko="0"
                        app:kq="@+id/gx"
                        app:srcCompat="@drawable/e5"/>
                    <ImageView
                        android:id="@+id/gv"
                        android:padding="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:tint="#ffffffff"
                        android:alpha="0.8"
                        app:k6="0"
                        app:ko="0"
                        app:kq="@+id/gw"
                        app:srcCompat="@drawable/e1"/>
                    <ImageView
                        android:id="@+id/gu"
                        android:padding="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:tint="#ffffffff"
                        android:alpha="0.8"
                        app:k6="0"
                        app:ko="0"
                        app:kq="@+id/gv"
                        app:srcCompat="@drawable/dg"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.didjdk.adbhelper.view.DragView>
        </com.didjdk.adbhelper.view.ControlView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/lx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/kj"
            android:paddingLeft="4dp"
            android:paddingTop="4dp"
            android:paddingRight="4dp"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:tint="@color/f4"
            app:srcCompat="@drawable/e6"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ki"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:tint="@color/f4"
                app:srcCompat="@drawable/e5"/>
            <ImageView
                android:id="@+id/kh"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:tint="@color/f4"
                app:srcCompat="@drawable/d1"/>
            <ImageView
                android:id="@+id/kg"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:tint="@color/f4"
                app:srcCompat="@drawable/dg"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
