<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:theme="?attr/j"
        android:id="@+id/pe"
        android:background="@color/a5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/d"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/i4"
        android:background="@color/a1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingEnd="8dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/e2"
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/qr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:singleLine="true"
            android:layout_weight="1"/>
        <com.google.android.material.chip.Chip
            android:textColor="@color/f4"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/qy"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minHeight="42dp"
            android:text="@string/g4"
            app:chipSurfaceColor="@color/e8"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ln"
        android:background="@color/a4"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/f4"
            android:gravity="center"
            android:id="@+id/qs"
            android:background="@color/e8"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/eg"/>
    </LinearLayout>
</LinearLayout>
