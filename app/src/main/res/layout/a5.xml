<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/pd"
        android:layout_width="match_parent"
        android:layout_height="?attr/d"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toTopOf="0"/>
    <ScrollView
        android:background="@color/a5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="0"
        app:layout_constraintEnd_toEndOf="0"
        app:layout_constraintStart_toStartOf="0"
        app:layout_constraintTop_toBottomOf="@+id/pd">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="640dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/i9"
                android:background="@drawable/ab"
                android:padding="1dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                app:layout_constraintEnd_toEndOf="0"
                app:layout_constraintStart_toStartOf="0"
                app:layout_constraintTop_toTopOf="0">
                <ImageView
                    android:id="@+id/g6"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tint="@color/x"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:srcCompat="@drawable/ap"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/x"
                    android:id="@+id/qm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="请插入设备"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/i1"
                android:background="@drawable/ag"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="0"
                app:layout_constraintStart_toStartOf="0"
                app:layout_constraintTop_toTopOf="0">
                <ImageView
                    android:id="@+id/eo"
                    android:layout_width="42dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:tint="@color/e8"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="0"
                    app:layout_constraintEnd_toStartOf="@+id/er"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="0"
                    app:layout_constraintTop_toTopOf="0"
                    app:srcCompat="@drawable/e8"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/e2"
                    android:id="@+id/er"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:text="正在获取设备信息..."
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@+id/eo"
                    app:layout_constraintTop_toTopOf="0"/>
                <TextView
                    android:textSize="8sp"
                    android:textColor="#ffffffff"
                    android:id="@+id/es"
                    android:background="@drawable/ai"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:text="连接中"
                    app:layout_constraintBottom_toBottomOf="0"
                    app:layout_constraintStart_toStartOf="@+id/er"
                    app:layout_constraintTop_toBottomOf="@+id/er"/>
                <ImageView
                    android:id="@+id/et"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="0"
                    app:layout_constraintEnd_toStartOf="@+id/eu"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintStart_toEndOf="@+id/er"
                    app:layout_constraintTop_toTopOf="0"
                    app:srcCompat="@drawable/d2"/>
                <ImageView
                    android:id="@+id/eu"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="0"
                    app:layout_constraintEnd_toEndOf="0"
                    app:layout_constraintTop_toTopOf="0"
                    app:srcCompat="@drawable/c2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.cardview.widget.CardView
                android:id="@+id/cb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintEnd_toEndOf="0"
                app:layout_constraintStart_toStartOf="0"
                app:layout_constraintTop_toBottomOf="@+id/i1">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/e4"
                        android:id="@+id/op"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="刷入镜像"
                        android:layout_marginStart="16dp"
                        app:layout_constraintBottom_toTopOf="@+id/h2"
                        app:layout_constraintStart_toStartOf="0"
                        app:layout_constraintTop_toTopOf="0"/>
                    <TextView
                        android:textSize="14sp"
                        android:id="@+id/h2"
                        android:background="@drawable/ah"
                        android:paddingLeft="8dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:hint="镜像文件路径"
                        android:paddingStart="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintEnd_toStartOf="@+id/mv"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toStartOf="0"
                        app:layout_constraintTop_toBottomOf="@+id/op"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/mv"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginEnd="8dp"
                        app:chipIcon="@drawable/bd"
                        app:iconStartPadding="16dp"
                        app:layout_constraintBottom_toBottomOf="@+id/h2"
                        app:layout_constraintEnd_toEndOf="0"
                        app:layout_constraintStart_toEndOf="@+id/h2"
                        app:layout_constraintTop_toTopOf="@+id/h2"/>
                    <TextView
                        android:id="@+id/oq"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="分区："
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/fe"
                        app:layout_constraintEnd_toStartOf="@+id/fe"
                        app:layout_constraintStart_toStartOf="0"
                        app:layout_constraintTop_toTopOf="@+id/fe"/>
                    <Spinner
                        android:entries="@array/c"
                        android:id="@+id/fe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintEnd_toStartOf="@+id/ev"
                        app:layout_constraintStart_toEndOf="@+id/oq"
                        app:layout_constraintTop_toTopOf="@+id/ev"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/e8"
                        android:id="@+id/ew"
                        android:visibility="invisible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="TextView"
                        android:layout_marginStart="8dp"
                        app:layout_constraintEnd_toEndOf="@+id/fe"
                        app:layout_constraintStart_toStartOf="@+id/fe"
                        app:layout_constraintTop_toBottomOf="@+id/fe"/>
                    <com.google.android.material.chip.Chip
                        android:textColor="@color/f4"
                        android:id="@+id/ev"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="刷入"
                        android:textAlignment="center"
                        android:layout_marginEnd="8dp"
                        app:chipSurfaceColor="@color/e4"
                        app:layout_constraintBottom_toBottomOf="0"
                        app:layout_constraintEnd_toEndOf="0"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@+id/fe"
                        app:layout_constraintTop_toBottomOf="@+id/mv"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/e4"
                android:id="@+id/ot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="自定义命令"
                android:layout_marginStart="32dp"
                app:layout_constraintEnd_toEndOf="0"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="0"
                app:layout_constraintTop_toBottomOf="@+id/cb"/>
            <EditText
                android:id="@+id/en"
                android:background="@drawable/ac"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="fastboot ..."
                android:ems="10"
                android:inputType="text"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="18dp"
                app:layout_constraintEnd_toStartOf="@+id/ep"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="0"
                app:layout_constraintTop_toBottomOf="@+id/ot"/>
            <com.google.android.material.chip.Chip
                android:textColor="@color/f4"
                android:id="@+id/ep"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:text="执行"
                android:textAlignment="center"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="18dp"
                app:chipSurfaceColor="@color/e4"
                app:layout_constraintBottom_toBottomOf="@+id/en"
                app:layout_constraintEnd_toEndOf="0"
                app:layout_constraintStart_toEndOf="@+id/en"
                app:layout_constraintTop_toTopOf="@+id/en"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/e4"
                android:id="@+id/ou"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="命令行输出"
                android:layout_marginStart="32dp"
                app:layout_constraintEnd_toEndOf="0"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="0"
                app:layout_constraintTop_toBottomOf="@+id/en"/>
            <androidx.core.widget.NestedScrollView
                android:id="@+id/mc"
                android:background="@drawable/ac"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                app:layout_constraintBottom_toBottomOf="0"
                app:layout_constraintEnd_toEndOf="0"
                app:layout_constraintStart_toStartOf="0"
                app:layout_constraintTop_toBottomOf="@+id/ou">
                <TextView
                    android:id="@+id/eq"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"/>
            </androidx.core.widget.NestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
